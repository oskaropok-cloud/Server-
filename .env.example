# Server Configuration
PORT=3000
NODE_ENV=production

# Redis Configuration (Upstash or local)
REDIS_URL=rediss://default:your_password@your-redis-host.upstash.io:6379
REDIS_TIMEOUT_MS=5000
REDIS_RETRY_ATTEMPTS=3

# Solana RPC Endpoints (ordered by priority)
PRIMARY_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_api_key
SECONDARY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_api_key
BACKUP_RPC_URL=https://api.mainnet-beta.solana.com
RPC_TIMEOUT_MS=10000
RPC_RETRY_ATTEMPTS=3

# Solana Token Mints
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
JUP_MINT=JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN

# Solana Keypairs (DO NOT commit real keys - use secure key management in production)
# For production, consider using AWS Secrets Manager, HashiCorp Vault, or similar
PRIVATE_KEY_BASE64=base64_encoded_keypair_bytes
PRIVATE_KEY_PASSPHRASE=optional_passphrase

# Wallet Addresses
WALLET=your_wallet_public_key
PUBLIC_KEY=your_wallet_public_key
ATTACK_WALLET=your_token_destination_wallet
JUP_ATTACK_WALLET=your_jup_token_destination_wallet

# Job Queue Configuration
JOB_ATTEMPTS=3
JOB_TIMEOUT_MS=60000
BLOCKHASH_CACHE_TTL_MS=30000

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_METRICS=true
